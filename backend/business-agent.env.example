# Copy your existing HARNESS_DATABASE_URL into private backend/.env.business-agent.
# This example contains placeholders only; actual configuration must remain ignored.
HARNESS_DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:5432/agent_harness"
HARNESS_AGENT_KIND=business_http
# Verify the current Windows gateway using: ip route show default
HARNESS_AGENT_BASE_URL=http://172.17.0.1:8020
HARNESS_AGENT_TOKEN_FILE="/mnt/d/ai_agent/project agent/data/runtime/harness-bridge/token.txt"
HARNESS_AGENT_TIMEOUT_SECONDS=110
